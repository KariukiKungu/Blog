@page "/shop"
@using LinkDotNet.Blog.Web.Features.Shop
@inject IShopService ShopService
@inject ICartService CartService

<PageTitle>Shop</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Shop</h1>
        <a class="btn btn-outline-primary" href="/cart">View cart</a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge text-bg-light">@product.Category</span>
                            <strong>@product.Price.ToString("C")</strong>
                        </div>

                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Description</p>
                        <div class="d-flex gap-2 mt-auto">
                            <a class="btn btn-outline-secondary" href="/shop/@product.Slug">Details</a>
                            <button class="btn btn-primary flex-grow-1" type="button" @onclick="() => AddToCart(product.Id)">Add to cart</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<Product> products = [];

    protected override void OnInitialized()
    {
        products = ShopService.GetProducts();
    }

    private async Task AddToCart(string productId)
    {
        await CartService.AddItemAsync(productId);
    }
}
