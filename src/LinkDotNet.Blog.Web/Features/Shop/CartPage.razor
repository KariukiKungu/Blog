@page "/cart"
@using LinkDotNet.Blog.Web.Features.Shop
@inject ICartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Cart</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Cart</h1>
        <a class="btn btn-outline-primary" href="/shop">Continue shopping</a>
    </div>

    @if (items.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Your cart is empty</h4>
            <p class="mb-0">Add a few products from the shop to get started.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                            <span class="fw-semibold">@item.Name</span>
                                        </div>
                                    </td>
                                    <td>@item.Price.ToString("C")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => Decrease(item.ProductId, item.Quantity)">-</button>
                                            <span>@item.Quantity</span>
                                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => Increase(item.ProductId)">+</button>
                                        </div>
                                    </td>
                                    <td>@(item.Price * item.Quantity).ToString("C")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => Remove(item.ProductId)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
            <div>
                <h4 class="mb-0">Total: @total.ToString("C")</h4>
            </div>
            <button class="btn btn-primary btn-lg" type="button" @onclick="Checkout">Checkout</button>
        </div>
    }
</div>

@code {
    private IReadOnlyList<CartItem> items = [];
    private decimal total;

    protected override async Task OnInitializedAsync()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        items = await CartService.GetCartAsync();
        total = await CartService.GetTotalAsync();
    }

    private async Task Increase(string productId)
    {
        await CartService.AddItemAsync(productId);
        await LoadCartAsync();
    }

    private async Task Decrease(string productId, int currentQuantity)
    {
        var nextQuantity = currentQuantity - 1;
        await CartService.UpdateQuantityAsync(productId, nextQuantity);
        await LoadCartAsync();
    }

    private async Task Remove(string productId)
    {
        await CartService.RemoveItemAsync(productId);
        await LoadCartAsync();
    }

    private async Task Checkout()
    {
        NavigationManager.NavigateTo("/checkout");
    }
}
